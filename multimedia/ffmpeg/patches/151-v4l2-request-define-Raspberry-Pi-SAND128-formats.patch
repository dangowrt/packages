From bf4b3b033065d770d65c656b4dbe6d383b611a5b Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Sun, 8 Nov 2026 22:26:27 +0000
Subject: [PATCH] v4l2-request: define the Raspberry Pi SAND128 pixelformats

The capture format table maps the Raspberry Pi HEVC decoder's
NV12_COL128, NV12_10_COL128 and their NV12MT variants to DRM SAND128
frames only where linux/videodev2.h defines them, but these formats
are downstream Raspberry Pi additions that the mainline kernel headers
of a cross toolchain lack. The table is then built without them, and
the hwaccel finds no capture format it supports on rpi-hevc-dec, so
HEVC falls back to software decoding. Define them when absent, with
the values of the Raspberry Pi kernel UAPI.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 libavutil/hwcontext_v4l2request.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

--- a/libavutil/hwcontext_v4l2request.c
+++ b/libavutil/hwcontext_v4l2request.c
@@ -46,6 +46,23 @@
 #define V4L2_PIX_FMT_YUV420_10_AFBC_16X16_SPLIT v4l2_fourcc('A', 'S', '0', '1')
 #endif
 
+/* Raspberry Pi downstream SAND128 pixelformats, absent from mainline */
+#ifndef V4L2_PIX_FMT_NV12_COL128
+#define V4L2_PIX_FMT_NV12_COL128                v4l2_fourcc('N', 'C', '1', '2')
+#endif
+
+#ifndef V4L2_PIX_FMT_NV12_10_COL128
+#define V4L2_PIX_FMT_NV12_10_COL128             v4l2_fourcc('N', 'C', '3', '0')
+#endif
+
+#ifndef V4L2_PIX_FMT_NV12MT_COL128
+#define V4L2_PIX_FMT_NV12MT_COL128              v4l2_fourcc('N', 'c', '1', '2')
+#endif
+
+#ifndef V4L2_PIX_FMT_NV12MT_10_COL128
+#define V4L2_PIX_FMT_NV12MT_10_COL128           v4l2_fourcc('N', 'c', '3', '0')
+#endif
+
 typedef struct V4L2RequestVideoDecoder {
     dev_t media_dev;
     dev_t video_dev;
