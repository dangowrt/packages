From 5e8df8deeaceabc871cc5a547d31182428e6105d Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Sun, 25 Oct 2026 12:59:09 +0000
Subject: [PATCH] v4l2codecs: find the devices through libudev

The plugin only enumerates the media devices and looks up the video
device node of a codec entity, which libudev offers directly. Using it
instead of GUdev drops the GLib wrapper, and with it the requirement for
a udev daemon's database on systems that provide the libudev API
without one, such as libudev-zero.
---
 sys/v4l2codecs/gstv4l2codecdevice.c | 67 ++++++++++++++++++++---------
 sys/v4l2codecs/meson.build          |  6 +--
 2 files changed, 50 insertions(+), 23 deletions(-)

--- a/sys/v4l2codecs/gstv4l2codecdevice.c
+++ b/sys/v4l2codecs/gstv4l2codecdevice.c
@@ -26,7 +26,7 @@
 #include "linux/media.h"
 
 #include <fcntl.h>
-#include <gudev/gudev.h>
+#include <libudev.h>
 #include <sys/ioctl.h>
 #include <sys/stat.h>
 
@@ -309,9 +309,11 @@ function_to_string (guint32 function)
 GList *
 gst_v4l2_codec_find_devices (void)
 {
-  GUdevClient *client;
-  GList *udev_devices, *d;
+  struct udev_enumerate *enumerate;
+  struct udev_list_entry *entry;
   GQueue devices = G_QUEUE_INIT;
+  GList *media_paths = NULL, *d;
+  struct udev *udev;
 
   /* Provide a fake device in documentation generation mode */
   if (!g_strcmp0 (g_getenv ("GST_V4L2_CODEC_GEN_DOC"), "1")) {
@@ -321,15 +323,37 @@ gst_v4l2_codec_find_devices (void)
     return devices.head;
   }
 
-  client = g_udev_client_new (NULL);
-  udev_devices = g_udev_client_query_by_subsystem (client, "media");
+  udev = udev_new ();
+  if (!udev) {
+    GST_WARNING ("Failed to create a udev context");
+    return NULL;
+  }
+
+  enumerate = udev_enumerate_new (udev);
+  udev_enumerate_add_match_subsystem (enumerate, "media");
+  udev_enumerate_scan_devices (enumerate);
+  udev_list_entry_foreach (entry, udev_enumerate_get_list_entry (enumerate)) {
+    struct udev_device *media;
+    const gchar *node;
+
+    media = udev_device_new_from_syspath (udev,
+        udev_list_entry_get_name (entry));
+    if (!media)
+      continue;
+
+    node = udev_device_get_devnode (media);
+    if (node)
+      media_paths = g_list_prepend (media_paths, g_strdup (node));
+    udev_device_unref (media);
+  }
+  udev_enumerate_unref (enumerate);
+  media_paths = g_list_reverse (media_paths);
 
-  if (!udev_devices)
+  if (!media_paths)
     GST_DEBUG ("Found no media devices");
 
-  for (d = udev_devices; d; d = g_list_next (d)) {
-    GUdevDevice *udev = (GUdevDevice *) d->data;
-    const gchar *path = g_udev_device_get_device_file (udev);
+  for (d = media_paths; d; d = g_list_next (d)) {
+    const gchar *path = d->data;
     gint fd;
     struct media_v2_topology topology;
     GList *codec_entities, *c;
@@ -363,7 +387,8 @@ gst_v4l2_codec_find_devices (void)
       struct media_v2_pad *sink_pad;
       struct media_v2_entity *source_entity, *sink_entity;
       struct media_v2_intf_devnode *source_dev, *sink_dev;
-      GUdevDevice *v4l2_udev;
+      struct udev_device *v4l2_udev;
+      const gchar *video_path;
 
       GST_DEBUG ("Analysing entity %s", entity->name);
 
@@ -390,26 +415,28 @@ gst_v4l2_codec_find_devices (void)
           || source_dev->minor != sink_dev->minor)
         continue;
 
-      v4l2_udev = g_udev_client_query_by_device_number (client,
-          G_UDEV_DEVICE_TYPE_CHAR,
+      v4l2_udev = udev_device_new_from_devnum (udev, 'c',
           makedev (source_dev->major, source_dev->minor));
       if (!v4l2_udev)
         continue;
 
-      GST_INFO ("Found %s device %s", function_to_string (entity->function),
-          entity->name);
-      g_queue_push_tail (&devices,
-          gst_v4l2_codec_device_new (entity->name, entity->function, path,
-              g_udev_device_get_device_file (v4l2_udev)));
-      g_object_unref (v4l2_udev);
+      video_path = udev_device_get_devnode (v4l2_udev);
+      if (video_path) {
+        GST_INFO ("Found %s device %s", function_to_string (entity->function),
+            entity->name);
+        g_queue_push_tail (&devices,
+            gst_v4l2_codec_device_new (entity->name, entity->function, path,
+                video_path));
+      }
+      udev_device_unref (v4l2_udev);
     }
 
     clear_topology (&topology);
     g_list_free (codec_entities);
   }
 
-  g_list_free_full (udev_devices, g_object_unref);
-  g_object_unref (client);
+  g_list_free_full (media_paths, g_free);
+  udev_unref (udev);
 
   return devices.head;
 }
--- a/sys/v4l2codecs/meson.build
+++ b/sys/v4l2codecs/meson.build
@@ -38,7 +38,7 @@ plugin_sources += {
   'v4l2codecs': pathsep.join(doc_sources)
 }
 
-libgudev_dep = dependency('gudev-1.0', required: get_option('v4l2codecs'), allow_fallback: true)
+libudev_dep = dependency('libudev', required: get_option('v4l2codecs'))
 
 if get_option('v4l2codecs').disabled()
   have_v4l2 = false
@@ -60,13 +60,13 @@ else
 endif
 
 
-if have_v4l2 and libgudev_dep.found()
+if have_v4l2 and libudev_dep.found()
   gstv4l2codecs = library('gstv4l2codecs',
     v4l2codecs_sources,
     c_args : gst_plugins_bad_args,
     cpp_args: gst_plugins_bad_args,
     include_directories : [configinc],
-    dependencies : [gstbase_dep, gstcodecs_dep, gstallocators_dep, libgudev_dep,
+    dependencies : [gstbase_dep, gstcodecs_dep, gstallocators_dep, libudev_dep,
                    gstpbutils_dep,],
     install : true,
     install_dir : plugins_install_dir,
