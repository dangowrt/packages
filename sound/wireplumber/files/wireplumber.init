#!/bin/sh /etc/rc.common
USE_PROCD=1
START=61
STOP=20

RUNDIR="/var/run/pipewire"
PW_USER="pipewire"
PW_GROUP="pipewire"

service_triggers() {
	# restart when pipewire service restarts
	procd_add_reload_trigger pipewire
}

start_service() {
	# RUNDIR is created and owned by pipewire.init (the SINGLE runtime-dir owner).
	# wireplumber is a pure client and must NOT touch it: this init used to chown
	# RUNDIR here and, starting last of the stack (START 61), silently reverted the
	# 'audio' group that pipewire/pipewire-pulse set - locking non-root clients
	# (librespot, snapserver, snapclient) out of the runtime dir on boot.

	# On boot this init runs right after pipewire's (START 60 -> 61), but
	# pipewire's daemon is spawned asynchronously by procd and hasn't created
	# its socket yet. A one-shot "socket present?" guard would therefore skip
	# the start *permanently* on boot (yet work when run by hand later) - the
	# reported "starts from shell but not on reboot". Wait briefly for the
	# socket; procd respawn below is the backstop if pipewire is slow.
	local i=0
	while [ ! -S "${RUNDIR}/pipewire-0" ] && [ "$i" -lt 15 ]; do
		sleep 1
		i=$((i + 1))
	done

	procd_open_instance
	procd_set_param command /usr/bin/wireplumber
	# retry=0 -> respawn indefinitely, so wireplumber recovers whenever
	# pipewire (re)appears instead of giving up after a few early failures.
	procd_set_param respawn 3600 5 0
	procd_set_param user "${PW_USER}"
	# group 'audio' for consistency with pipewire/pipewire-pulse (see pipewire.init).
	procd_set_param group audio
	# NOTE: do NOT set WIREPLUMBER_CONFIG_DIR. In WirePlumber 0.5 it *replaces*
	# the whole config search path (base-dirs.c lookup_dirs()) rather than adding
	# to it, so pointing it at /etc/wireplumber drops /usr/share/wireplumber -
	# where the base wireplumber.conf (context.modules, incl. protocol-native)
	# lives - and WP fails with "can't find protocol PipeWire:Protocol:Native".
	# The default path already includes /etc/wireplumber, so our conf.d drop-ins
	# are picked up regardless.
	procd_set_param env \
		XDG_RUNTIME_DIR="${RUNDIR}" \
		PIPEWIRE_RUNTIME_DIR="${RUNDIR}" \
		HOME="${RUNDIR}" \
		PW_LOG=2
	# RT for the audio data-loop: wireplumber HOSTS the bluez sink nodes (SBC
	# encode runs in this process), so it needs realtime just like pipewire.
	# (see pipewire.init; module-rt + RLIMIT_RTPRIO, no rtkit on OpenWrt)
	procd_set_param limits rtprio="95 95" nice="40 40"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
