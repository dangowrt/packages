#!/bin/sh /etc/rc.common
USE_PROCD=1
START=60
STOP=20

RUNDIR="/var/run/pipewire"
PW_USER="pipewire"
PW_GROUP="pipewire"

start_service() {
	# single shared runtime dir for system-mode. Socket access follows the
	# pulseaudio model (which builds with -Daccess_group=audio): the sockets are
	# group 'audio', reachable by any client in that standard group regardless of
	# which sound server is installed. pipewire keeps its own USER (pipewire) but
	# runs with primary group 'audio' (procd 'group' below) - pulseaudio's
	# equivalent of chgrp'ing its socket to access_group - so every socket/dir it
	# creates is group 'audio'. With umask 007 that yields native socket
	# audio:0770 and pulse dir audio:0750. RUNDIR is group 'audio' so those
	# members can traverse to the sockets.
	#
	# This service (START 60, first of the stack and a hard dependency of the
	# other two) is the SINGLE owner of RUNDIR. pipewire-pulse and wireplumber
	# deliberately do NOT chown/chmod it (see their inits) - several services
	# fighting over the same dir is what let wireplumber revert the group before.
	mkdir -p "${RUNDIR}"
	chown "${PW_USER}:audio" "${RUNDIR}"
	chmod 0750 "${RUNDIR}"

	# Let the unprivileged pipewire user open the ALSA devices in /dev/snd
	# (root:audio, 0660): the package's USERID only sets its primary group, so
	# add it to 'audio' here. Idempotent; procd applies supplementary groups
	# when it drops privileges to PW_USER. Needed for the ALSA sink/monitor.
	[ -f /lib/functions.sh ] && . /lib/functions.sh
	group_add_user audio "${PW_USER}" 2>/dev/null

	# umask 007 so the daemon creates its runtime sockets group-accessible: the
	# native socket becomes 0770 (group-writable -> group members can connect)
	# instead of 0755. Combined with the 0750 RUNDIR, any service in the
	# 'pipewire' group can use the audio server as its own unprivileged user
	# (no root needed); 'other' stays denied. procd spawns the command with its
	# own umask, so it must be set in the exec'd shell, not in start_service.
	procd_open_instance
	procd_set_param command /bin/sh -c 'umask 007; exec /usr/bin/pipewire'
	procd_set_param respawn 3600 5 5
	procd_set_param user "${PW_USER}"
	# primary group 'audio' (not the pipewire group) so created sockets are
	# group 'audio' - the shared access group (see comment above).
	procd_set_param group audio
	procd_set_param env \
		XDG_RUNTIME_DIR="${RUNDIR}" \
		PIPEWIRE_RUNTIME_DIR="${RUNDIR}" \
		HOME="${RUNDIR}" \
		PW_LOG=2
	procd_set_param limits nofile="8192 8192"
	# Allow module-rt to give the audio data-loop realtime priority via
	# sched_setscheduler (no rtkit on OpenWrt; needs RLIMIT_RTPRIO). Without
	# this every data loop runs SCHED_OTHER and audio crackles under CPU load.
	# nice="40 40" (RLIMIT_NICE) lets module-rt's default renice to -11 succeed:
	# if that renice FAILS, module-rt falls back to the RTKit D-Bus path, which
	# doesn't exist on OpenWrt and silently yields no realtime at all.
	procd_set_param limits rtprio="95 95" nice="40 40"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
