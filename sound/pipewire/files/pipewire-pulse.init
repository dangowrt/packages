#!/bin/sh /etc/rc.common
USE_PROCD=1
START=61
STOP=19

RUNDIR="/var/run/pipewire"
PW_USER="pipewire"
PW_GROUP="pipewire"

start_service() {
	# RUNDIR itself is created and owned (pipewire:audio 0750) by pipewire.init -
	# the stack's first service (START 60) and the SINGLE owner of the runtime dir.
	# Don't chown/chmod RUNDIR here; several services fighting over the same dir is
	# what let wireplumber silently revert its group. We only manage our own pulse/
	# socket subdir.
	#
	# pipewire-pulse creates pulse/ as 0700 (owner-private) when missing but reuses
	# an existing one as-is, so pre-create it group 'audio' 0750 - lets pulse
	# clients in the 'audio' group traverse to pulse/native.
	mkdir -p "${RUNDIR}/pulse"
	chown "${PW_USER}:audio" "${RUNDIR}/pulse"
	chmod 0750 "${RUNDIR}/pulse"

	# umask 007 so the pulse runtime subdir is created 0750 (group-traversable)
	# instead of 0700; the pulse socket itself stays 0777. Lets 'pipewire'-group
	# clients (e.g. librespot as its own user) reach pulse/native. See pipewire.init.
	procd_open_instance
	procd_set_param command /bin/sh -c 'umask 007; exec /usr/bin/pipewire-pulse'
	procd_set_param respawn 3600 5 5
	procd_set_param user "${PW_USER}"
	# primary group 'audio' so the pulse socket/dir are group 'audio' (see pipewire.init).
	procd_set_param group audio
	procd_set_param env \
		XDG_RUNTIME_DIR="${RUNDIR}" \
		PIPEWIRE_RUNTIME_DIR="${RUNDIR}" \
		HOME="${RUNDIR}" \
		PW_LOG=2
	procd_set_param limits nofile="8192 8192"
	# RT for the data loop (see pipewire.init).
	procd_set_param limits rtprio="95 95" nice="40 40"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
