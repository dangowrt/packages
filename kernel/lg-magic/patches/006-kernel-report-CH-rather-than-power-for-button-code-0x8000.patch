From 94f9a206e7cc46f7185a1f4064680be629fc893c Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Thu, 17 Sep 2026 14:28:53 +0100
Subject: [PATCH] kernel: report CH+ rather than power for button code 0x8000

The remote sends byte-identical reports for POWER and CH+, so one key
code has to serve both. Kodi turns the power key into its shutdown
menu, which makes CH+ unusable, while a stray channel change from the
power button costs nothing. Report KEY_CHANNELUP.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 kernel/lg_magic_main.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/kernel/lg_magic_main.c b/kernel/lg_magic_main.c
index f576dae..3cf2503 100644
--- a/kernel/lg_magic_main.c
+++ b/kernel/lg_magic_main.c
@@ -66,7 +66,9 @@ static const struct {
 	u16 code;
 	u16 keycode;
 } lg_btn_map[] = {
-	{ 0x8000, KEY_POWER },
+	/* the remote sends this for both POWER and CH+, and CH+ is the one
+	   a media centre needs */
+	{ 0x8000, KEY_CHANNELUP },
 	{ 0x8099, KEY_SLEEP },
 	{ 0x8010, KEY_0 }, { 0x8011, KEY_1 }, { 0x8012, KEY_2 },
 	{ 0x8013, KEY_3 }, { 0x8014, KEY_4 }, { 0x8015, KEY_5 },
@@ -86,7 +88,6 @@ static const struct {
 	{ 0x805D, KEY_MEDIA }, // IVI
 	{ 0x800B, KEY_TV },
 	{ 0x8098, KEY_CONTEXT_MENU }, // STB MENU
-	//{ 0x8000, KEY_CHANNELUP }, // Somehow it collides with power button
 	{ 0x8001, KEY_CHANNELDOWN },
 	{ 0x8072, KEY_RED },
 	{ 0x8071, KEY_GREEN },
-- 
